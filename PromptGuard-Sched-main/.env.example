# PromptGuard-Sched — environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Secrets -----------------------------------------------------------------
HF_TOKEN=                          # HuggingFace access token, for gated model weights
# OPENAI_API_KEY=                  # only if/when an API model is added (blueprint §11, optional)

# --- Database ------------------------------------------------------------
# SQLite for early dev (README §5); switch to Postgres for the real experimental matrix.
DATABASE_URL=sqlite:///./data/promptguard_sched.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/promptguard_sched

# --- Cache (optional, §9) ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_ENABLED=true             # cache keyed on (prompt_hash, model_id, temperature)

# --- Model backends (blueprint §11 — record model_id on every experiment) ---
LLM_MODEL_IDS=meta-llama/Llama-3.2-3B-Instruct,Qwen/Qwen2.5-3B-Instruct
LLM_QUANTIZATION=4bit              # RTX 3050 6GB — do not assume full-precision fits
LLM_DEVICE=cuda

# --- Experiment defaults (§4, §12 — never hardcode these in business logic) ---
TAU_ASR_DEFAULT=0.25               # attack-success threshold on Delta(J)
TAU_ASR_SWEEP=0.10,0.25,0.50
INJECTION_RATIOS=0.01,0.05,0.10
DEFAULT_SEED_COUNT=5
DEFENSE_CONFIG_DEFAULT=none        # none | guard_only | trust_only | ilp_anomaly_only | full

# --- Dataset ------------------------------------------------------------
CLUSTER_TRACE_PATH=./data/google_trace_subset/
TRACE_DAYS_SUBSET=2                # start with a 1-2 day subset, not the full 29-day trace

# --- Runtime -------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
